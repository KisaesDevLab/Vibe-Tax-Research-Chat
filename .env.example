# Vibe Tax Research Chat — environment template.
# Copy to .env and fill in values. NEVER commit .env.

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:5173

# Comma-separated CORS allowlist. Optional — falls back to PUBLIC_BASE_URL.
# Each entry is either a literal origin or `regex:<pattern>`. The appliance
# triplet (primary HTTPS / Tailscale / emergency :5191) sets all three at once.
# Example: ALLOWED_ORIGIN=https://tax.firm.com,https://tax.tailnet-x.ts.net,http://192.168.1.42:5191
ALLOWED_ORIGIN=

# Cookie Secure-flag policy: auto | true | false. `auto` derives from
# req.secure (works for both HTTPS primary and plain-HTTP emergency mode).
COOKIE_SECURE=auto

# Number of proxy hops to trust for X-Forwarded-* headers. 1 = the immediate
# reverse proxy (Caddy / nginx / appliance Caddy / HAProxy emergency-proxy).
TRUST_PROXY=1

# Run migrations automatically on API startup before binding the listener.
# Default false — operator runs `pnpm db:migrate:prod` explicitly. The
# appliance overlay flips this to true so the bootstrapper doesn't need a
# separate exec step.
MIGRATIONS_AUTO=false

# ── Database (Postgres 16) ──────────────────────────────────────────────
DATABASE_URL=postgres://vibe:vibe@localhost:5439/vibe_tax

# ── Cache / queue (Redis 7) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6389

# ── Crypto ──────────────────────────────────────────────────────────────
# 32-byte (64-hex) master key for AES-256-GCM HKDF derivation.
# Generate: openssl rand -hex 32
MASTER_KEY=

# ── JWT ─────────────────────────────────────────────────────────────────
# Generate each independently: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Bootstrap admin (Phase 2 seed) ──────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme-on-first-login

# ── Skills repo ─────────────────────────────────────────────────────────
SKILLS_REPO_URL=https://github.com/KisaesDevLab/Vibe-Claude-Tax-Research-Skills
SKILLS_REPO_PIN_TYPE=branch
SKILLS_REPO_PIN_VALUE=main
SKILLS_WORKSPACE_DIR=./workspaces/skills
GITHUB_WEBHOOK_SECRET=

# ── Anthropic ───────────────────────────────────────────────────────────
# The runtime key is stored encrypted in the DB via /api/admin/settings/anthropic-key.
# This var is only used by integration tests and dev scripts.
ANTHROPIC_API_KEY=

# ── Manifest sources ────────────────────────────────────────────────────
MODELS_MANIFEST_URL=https://vibemb.com/manifests/anthropic-models.json

# ── Embeddings (Phase 32 — firm reference library) ──────────────────────
# Voyage AI is the default provider. Issue a key at https://dash.voyageai.com/.
# voyage-3-large is 1024-dim cosine; we pin 1024 in the schema so other models
# either match or get truncated. Optional: leave EMBEDDINGS_API_KEY empty if
# you don't intend to upload firm references — chat works without it.
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_MODEL=voyage-3-large
EMBEDDINGS_API_KEY=

# ── Backups (Phase 27) ──────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
DUPLICATI_TARGET=
