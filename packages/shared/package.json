{
  "name": "@vibe/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./skills/*": {
      "types": "./dist/skills/*.d.ts",
      "default": "./dist/skills/*.js"
    },
    "./web-allowlist": {
      "types": "./dist/web-allowlist.d.ts",
      "default": "./dist/web-allowlist.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
